# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and never sent to the browser.
# Set the same variables in Vercel → Settings → Environment Variables.

# --- DeepSeek (parsing + explanations) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- OpenAI (embeddings only — text-embedding-3-small, 1536 dims) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ-your-service-role-key

# --- Spam protection (Cloudflare Turnstile) — optional locally, required before public launch ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
